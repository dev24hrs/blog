---
import { getSortedPosts } from "@/lib/posts"

export async function getStaticPaths() {
  const posts = await getSortedPosts(true)
  return posts.map((post) => ({
    params: { slug: post.id },
  }))
}

const slugParam = Astro.params.slug
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam

// 旧路径 /post/* → /posts/*。
// 这里不用 Astro.redirect()：它的静态产物只有 doctype/title/meta/body，没有 <html>，
// 会被 Pagefind 判为「无根元素」并报警告。手写完整文档，并用 data-pagefind-ignore
// 让这页不进索引（它没有任何可索引的词，因此不可能出现在搜索结果里）。
const target = slug ? `/posts/${encodeURI(slug)}/` : "/"
const canonical = Astro.site ? new URL(target, Astro.site).toString() : target
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to: {target}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
  </head>
  <body data-pagefind-ignore>
    <p>
      Redirecting from <code>{Astro.url.pathname}</code> to
      <a href={target}><code>{target}</code></a>
    </p>
  </body>
</html>
